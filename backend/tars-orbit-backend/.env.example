PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/tars_orbit
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
ADMIN_BOOTSTRAP_EMAIL=admin@tarsorbit.edu
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345
# Optional cloud AI (OpenAI-compatible)
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Local AI: install Ollama and pull the model on the machine running the backend.
LOCAL_AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_CONTEXT=12288
OLLAMA_TEMPERATURE=0.18

# Optional web research. Leave the API key blank to use the public Wikipedia fallback.
WEB_RESEARCH_ENABLED=true
WEB_SEARCH_API_URL=https://api.tavily.com/search
WEB_SEARCH_API_KEY=
UPLOAD_DIR=./uploads
